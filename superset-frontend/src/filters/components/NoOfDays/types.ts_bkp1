import {
  Behavior,
  ChartMetadata,
  ChartPlugin,
  t,
} from '@superset-ui/core';

import buildQuery from './buildQuery';
import transformProps from './transformProps';

export default class NoOfDaysFilterPlugin
  extends ChartPlugin {
  constructor() {
    const metadata = new ChartMetadata({
      name: t('No of Days'),
      description: t('Rolling number of days filter'),
      behaviors: [
        Behavior.InteractiveChart,
        Behavior.NativeFilter,
      ],
      tags: [t('Experimental')],
      enableNoResults: false,
    });

    super({
      buildQuery,
      loadChart: () => import('./NoOfDaysFilterPlugin'),
      metadata,
      transformProps,
    });
  }
}
